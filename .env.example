# Flowly API base URL (without the /api suffix)
FLOWLY_API_URL=http://localhost:3000

# Public URL the plugin bundle is served from (used in production manifests)
FLOWLY_PLUGIN_URL=http://localhost:4701

# Giphy API key, optional (GIF picker is disabled without it): https://developers.giphy.com/
GIPHY_API_KEY=
