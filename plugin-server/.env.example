# ─── Server ───────────────────────────────────────────────────────────────────
# Port the WebSocket server listens on.
PORT=8094
# Bind address. Use 0.0.0.0 to accept connections from all interfaces (required
# inside Docker). Keep 127.0.0.1 for production installs behind nginx/HAProxy.
HOST=127.0.0.1

# ─── BigBlueButton ────────────────────────────────────────────────────────────
# bbb-web session-token validation endpoint.
# bbb-docker dev setup: http://10.7.7.2:8090/bigbluebutton/connection/checkGraphqlAuthorization
BBB_AUTH_URL=http://127.0.0.1:8090/bigbluebutton/connection/checkGraphqlAuthorization

# ─── Redis ────────────────────────────────────────────────────────────────────
# Used for Akka pub/sub and meeting event subscriptions.
# bbb-docker dev setup: 10.7.7.5
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
# BigBlueButton GraphQL database. Leave PG_HOST empty to disable PostgreSQL
# (the user:rename event then fails).
# bbb-docker dev setup: 10.7.7.22, database hasura_app, user postgres
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DB=bbb_graphql
PG_USER=flowly
PG_PASSWORD=change-me
