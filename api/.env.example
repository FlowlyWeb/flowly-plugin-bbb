# ==============================================================================
# FLOWLY API - Environment Configuration
# ==============================================================================
# Application Layer API for institution and BigBlueButton management
# Can be deployed on-premise (standalone) or SaaS (multi-tenant)

# ==============================================================================
# APPLICATION
# ==============================================================================

NODE_ENV=development
PORT=3000
HOST=127.0.0.1

# ==============================================================================
# DATABASE
# ==============================================================================

DB_HOST=localhost
DB_PORT=5432
DB_NAME=flowly
DB_USER=postgres
DB_PASS=your_secure_password_here

# ==============================================================================
# SECURITY
# ==============================================================================

# JWT Secret (min 64 characters) - Generate with: .\generate-secrets.ps1
# IMPORTANT: Must be the SAME as flowly-core in SaaS mode
JWT_SECRET=your_secure_jwt_secret_change_this_in_production_min_64_chars

# ==============================================================================
# DEPLOYMENT MODE
# ==============================================================================

# Deployment mode: 'saas' or 'onpremise'
DEPLOYMENT_MODE=saas

# ==============================================================================
# ON-PREMISE MODE ONLY (Comment out if DEPLOYMENT_MODE=saas)
# ==============================================================================

# JWT License Token (obtained from flowly-core admin)
# This token allows 100% offline operation with optional check-ins
# LICENSE_TOKEN=eyJhbGciOiJSUzI1NiIs...

# Public key for JWT verification (PEM format, use \n for newlines)
# LICENSE_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMIIBIj...\n-----END PUBLIC KEY-----"

# flowly-core URL for check-ins (optional, enables revocation checking)
# LICENSE_CORE_URL=https://core.flowlyweb.com

# Grace period in days when check-ins fail (default: 7)
# LICENSE_GRACE_PERIOD_DAYS=7

# Legacy license key (deprecated - use LICENSE_TOKEN instead)
# LICENSE_KEY=FLOWLY-XXXX-XXXX-XXXX-XXXX

# Legacy validation URL (deprecated - use LICENSE_CORE_URL instead)
# LICENSE_VALIDATION_URL=https://core.flowlyweb.com

# ==============================================================================
# WATCHTOWER (On-Premise Only)
# ==============================================================================

# Watchtower HTTP API URL
# Default: http://localhost:8080
# Watchtower monitors Docker containers and applies updates automatically
WATCHTOWER_API_URL=http://localhost:8080

# Watchtower HTTP API authentication token
# Must match the WATCHTOWER_HTTP_API_TOKEN in your docker-compose.yml
# Generate a secure random token for production
WATCHTOWER_TOKEN=your_secure_watchtower_token_here

# Docker registry URL for Flowly images
# Used to construct full image names for version detection
# Default: registry.example.com/flowlyweb
DOCKER_REGISTRY=registry.example.com/flowlyweb

# Flowly installation directory (for backups and scripts)
# Default: /opt/flowly
# FLOWLY_INSTALL_DIR=/opt/flowly

# ==============================================================================
# UPDATE HEALTH CHECK (On-Premise Only)
# ==============================================================================

# Number of health check attempts after update (default: 20)
# Total wait time = attempts × interval
# UPDATE_HEALTH_CHECK_ATTEMPTS=20

# Interval between health checks in milliseconds (default: 30000 = 30 seconds)
# UPDATE_HEALTH_CHECK_INTERVAL_MS=30000

# Health check URLs (override if using non-standard ports or paths)
# UPDATE_API_HEALTH_URL=http://localhost:3000/api/health
# UPDATE_DASHBOARD_HEALTH_URL=http://localhost:3002
# UPDATE_PLUGIN_HEALTH_URL=http://localhost:3003/manifest.json

# Backup retention: number of pre-update backups to keep (default: 5)
# Oldest backups are automatically deleted after each update
# UPDATE_BACKUP_RETENTION_COUNT=5

# ==============================================================================
# EMAIL / SMTP CONFIGURATION
# ==============================================================================
# Required for password resets, welcome emails, and update notifications (on-premise)
# Set DISABLE_EMAILS=true to skip email functionality in development

# Disable email sending (useful for local development)
DISABLE_EMAILS=false

# SMTP Server Configuration
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=noreply@example.com
EMAIL_PASSWORD=your_smtp_password_here

# Email Sender Configuration
EMAIL_SENDER=noreply@example.com
EMAIL_SENDER_NAME=FlowlyWeb

# Support email (displayed in email footers)
SUPPORT_EMAIL=support@example.com

# Admin email for update notifications (on-premise only)
# If not set, notifications are stored in dashboard only
ADMIN_NOTIFICATION_EMAIL=admin@example.com

# Application URL (for links in notification emails)
APP_URL=https://your-domain.com

# Frontend URL (used in email templates for links)
FRONTEND_URL=https://your-domain.com

# ==============================================================================
# LOGGING
# ==============================================================================

LOG_LEVEL=debug
