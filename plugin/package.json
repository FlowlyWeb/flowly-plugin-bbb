{
  "name": "flowly-plugin-bbb",
  "version": "2.0.2",
  "description": "FlowlyWeb plugin for BigBlueButton: theming, mentions, GIFs, question highlighting and moderator tools",
  "author": "Geezot",
  "license": "AGPL-3.0-only",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/FlowlyWeb/flowly-plugin-bbb.git",
    "directory": "plugin"
  },
  "packageManager": "pnpm@10.19.0",
  "scripts": {
    "build": "cross-env BBB_VERSION=3.1 webpack --mode production --no-watch",
    "build:3.0": "cross-env BBB_VERSION=3.0 webpack --mode production --no-watch",
    "build:3.1": "cross-env BBB_VERSION=3.1 webpack --mode production --no-watch",
    "build:all": "pnpm run build:3.0 && pnpm run build:3.1",
    "dev": "webpack --mode development --watch",
    "start": "webpack --mode development --no-watch && webpack serve --mode development",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "clean": "rimraf dist dist-3.0 dist-3.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "type-check": "tsc --noEmit",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@giphy/js-fetch-api": "^5.7.0",
    "@giphy/react-components": "^10.1.1",
    "bigbluebutton-html-plugin-sdk": "0.1.14",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-modal": "^3.16.3"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.0",
    "@babel/preset-react": "^7.28.5",
    "@eslint/js": "^10.0.1",
    "@giphy/js-types": "5.1.0",
    "@types/node": "^25.2.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-modal": "^3.16.3",
    "@vitejs/plugin-react": "^4.5.2",
    "@vitest/coverage-v8": "^3.2.4",
    "babel-loader": "^10.0.0",
    "copy-webpack-plugin": "^14.0.0",
    "cross-env": "^10.1.0",
    "css-loader": "^7.1.3",
    "dotenv": "^17.3.1",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "~7.0.1",
    "jsdom": "^26.1.0",
    "prettier": "^3.8.1",
    "rimraf": "^6.1.3",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.2",
    "vitest": "^3.2.1",
    "webpack": "^5.105.0",
    "webpack-cli": "^7.0.2",
    "webpack-dev-server": "^5.2.3"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
